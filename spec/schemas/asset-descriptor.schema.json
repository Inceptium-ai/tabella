{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udap.dev/schemas/0.1.0/asset-descriptor.schema.json",
  "title": "UDAP Asset Descriptor",
  "type": "object",
  "required": ["udap_version", "id", "name", "domain", "classification", "source", "schema"],
  "properties": {
    "udap_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "owner": {"type": ["string", "null"]},
    "domain": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "source": {
      "type": "object",
      "required": ["connector", "uri", "native_name"],
      "properties": {
        "connector": {"type": "string"},
        "uri": {"type": "string"},
        "native_name": {"type": "string"}
      }
    },
    "schema": {
      "type": "object",
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"enum": ["string", "integer", "number", "boolean", "date", "datetime", "json", "binary", "unknown"]},
              "nullable": {"type": "boolean"},
              "description": {"type": ["string", "null"]},
              "semantic_tags": {"type": "array", "items": {"type": "string"}},
              "pii": {"type": "boolean"}
            }
          }
        },
        "primary_key": {"type": "array", "items": {"type": "string"}},
        "foreign_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fields", "ref_asset", "ref_fields"],
            "properties": {
              "fields": {"type": "array", "items": {"type": "string"}},
              "ref_asset": {"type": "string"},
              "ref_fields": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "read_roles": {"type": "array", "items": {"type": "string"}},
        "row_limit": {"type": "integer", "minimum": 1}
      }
    },
    "enablement": {
      "type": "object",
      "properties": {
        "api": {"type": "boolean"},
        "mcp": {"type": "boolean"},
        "vectorization": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "content_fields": {"type": "array", "items": {"type": "string"}},
            "chunking": {"enum": ["semantic", "fixed", "document"]},
            "chunk_size": {"type": "integer", "minimum": 1},
            "embedding_model": {"type": ["string", "null"]}
          }
        }
      }
    },
    "custom_properties": {"type": "object", "additionalProperties": {"type": "string"}},
    "lineage": {"type": "array", "items": {"type": "string"}}
  }
}
