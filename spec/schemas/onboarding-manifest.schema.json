{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udap.dev/schemas/0.1.0/onboarding-manifest.schema.json",
  "title": "UDAP Onboarding Manifest",
  "type": "object",
  "required": ["udap_version", "asset", "source"],
  "properties": {
    "udap_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "asset": {
      "type": "object",
      "required": ["name", "domain", "classification"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]},
        "domain": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["connector", "uri", "native_name"],
      "properties": {
        "connector": {"type": "string"},
        "uri": {"type": "string"},
        "native_name": {"type": "string"}
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"enum": ["string", "integer", "number", "boolean", "date", "datetime", "json", "binary", "unknown", null]},
              "required": {"type": "boolean"},
              "pii": {"type": "boolean"}
            }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "read_roles": {"type": "array", "items": {"type": "string"}},
        "row_limit": {"type": "integer", "minimum": 1}
      }
    },
    "enablement": {
      "type": "object",
      "properties": {
        "api": {"type": "boolean"},
        "mcp": {"type": "boolean"},
        "vectorization": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "content_fields": {"type": "array", "items": {"type": "string"}},
            "chunking": {"enum": ["semantic", "fixed", "document"]},
            "chunk_size": {"type": "integer", "minimum": 1},
            "embedding_model": {"type": ["string", "null"]}
          }
        }
      }
    },
    "custom_properties": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
